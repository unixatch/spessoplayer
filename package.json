{
  "name": "spessoplayer",
  "version": "0.8.925-beta",
  "description": "A midi converter that uses spessasynth_core to generate the data",
  "homepage": "https://github.com/unixatch/spessoplayer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unixatch/spessoplayer.git"
  },
  "bugs": "https://github.com/unixatch/spessoplayer/issues",
  "keywords": [
    "midi", "soundfont",
    "mid", "sf2", "dls",
    "midiplayer", "player",
    "cli",
    "node",
    "stdout",
    "lossless", "lossy",
    "wav", "pcm", "flac", "mp3"
  ],
  "license": "GPL-3.0-only",
  "author": "unixatch",
  "type": "module",
  "main": "main.mjs",
  "min-release-age": "4",
  "preferGlobal": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "spessoplayer": "main.mjs"
  },
  "scripts": {
    "prepublishOnly": "node prepublish.mjs",
    "postinstall": "node install.mjs"
  },
  "dependencies": {
    "spessasynth_core": "^4.0.25"
  }
}

