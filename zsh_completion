__spessoplayer() {
  local curcontext="$curcontext" prev
  typeset -A opt_args
  cur=$words[CURRENT]
  #                       ↓ removes :<index> at the end
  prev=${words[CURRENT-1]%:*}

  case $prev in
    --input | -i | --log-file | -lf)
      _files
      return 0
    ;;
    --volume | --reverb-volume | \
    -vol     | -rvb)
      local numbers=({0..100})
      _arguments "*: :(${numbers[*]})"
      return 0
    ;;
    --effects | -e)
      local effects=(
        "firfit"      "flanger"    "bass"
        "loudness"    "lowpass"    "compand"
        "mcompand"    "noiseprof"  "dither"
        "allpass"     "band"       "echos"
        "bandpass"    "bandreject" "fir"
        "bend"        "biquad"     "ladspa"
        "chorus"      "channels"   "overdrive"
        "contrast"    "dcshift"    "remix"
        "deemph"      "delay"      "sinc"
        "divide"      "downsample" "stats"
        "earwax"      "echo"       "treble"
        "equalizer"   "fade"       "vol"
        "gain"        "highpass"   "repeat"
        "hilbert"     "input"
        "noisered"    "norm"
        "oops"        "output"
        "pad"         "phaser"
        "pitch"       "rate"
        "reverb"      "reverse"
        "riaa"        "silence"
        "spectrogram" "speed"
        "splice"      "stat"
        "stretch"     "swap"
        "synth"       "tempo"
        "tremolo"     "trim"
        "upsample"    "vad"
      )
      _arguments "*: :(${effects[*]})"
      return 0
    ;;
    --loop | --loop-start | --loop-end | \
    -l     | -ls          | -le        | \
    --loop-fade | --loop-fade-start | --loop-fade-duration | \
    -lF         | -lFs    | -lFd)
      local numbers=({0..10})
      _arguments "*: :(${numbers[*]})"
      return 0
    ;;
    --sample-rate | -r)
      local numbers=({0..96000})
      _arguments "*: :(${numbers[*]})"
      return 0
    ;;
    --threads | -T | --max-threads | -mt)
      COMPREPLY=({1..16})
      local numbers=({0..16})
      _arguments "*: :(${numbers[*]})"
      return 0
    ;;
    --format | -f)
      local formats=(
        "wav"
        "flac" "mp3" "opus"
        "pcm" "f32le"
      )
      _arguments "*: :(${formats[*]})"
      return 0
    ;;
    --text-delay | -d)
      local numbers=({50..10000})
      _arguments "*: :(${numbers[*]})"
      return 0
    ;;
    --verbose | -v)
      local numbers=({0..3})
      _arguments "*: :(${numbers[*]})"
      return 0
    ;;
  esac

  [[ $cur =~ .* ]] && {
    local all_arguments=(
      "--input[manual input method]"                      "-i[manual input method]"
      "--volume[audio volume]"                            "-vol[audio volume]"
      "--reverb-volume[reverb audio volume]"              "-rvb[reverb audio volume]"
      "--effects[SoX effects]"                            "-e[SoX effects]"
      "--loop[loop count]"                                "-l[loop count]"
      "--loop-start[start of loop]"                       "-ls[start of loop]"
      "--loop-end[end of loop]"                           "-le[end of loop]"
      "--loop-fade[1 more loop but only for fading]"      "-lF[1 more loop but only for fading]"
      "--loop-fade-start[start of loop fade]"             "-lFs[start of loop fade]"
      "--loop-fade-duration[duration of loop fade]"       "-lFd[duration of loop fade]"
      "--sample-rate[audio samplerate]"                   "-r[audio samplerate]"
      "--format[stdout file format]"                      "-f[stdout file format]"
      "--max-threads[amount of threads]"                  "-mt[amount of threads]"
      "--threads[amount of threads]"                      "-T[amount of threads]"
      "--show-usage[display usage in file mode]"          "-U[display usage in file mode]"
      "--text-delay[delay of file mode's progress bar]"   "-d[delay of file mode's progress bar]"
      "--no-progress[disable file mode's progress]"       "-np[disable file mode's progress]"
      "--ask[confirmation of grouped files]"              "-a[confirmation of grouped files]"          
      "--confirm[confirmation of grouped files]"          "-c[confirmation of grouped files]"
      "--no-table[no table when asking for confirmation]" "-nt[no table when asking for confirmation]"
      "--dry-run[run without applying]"                   "-dr[run without applying]"                  
      "--test[run without applying]"                      "-t[run without applying]"        
      "--null[run without applying]"                      "-0[run without applying]"
      "--verbose[log/verbosity level]"                    "-v[log/verbosity level]"
      "--daemon[server mode]"                             "-D[server mode]"
      "--log-file[log file path]"                         "-lf[log file path]"
      "--uninstall[uninstall the program]"                "-u[uninstall the program]"
      "--help[help page]"                                 "-h[help page]"
      "--version[shows the version]"                      "-V[shows the version]"
      "--enable-spessasynth-logging[enables all spessasynth's log levels]"
      "--enable-spessasynth-warn-logging[enables spessasynth's warn log level]"
      "--enable-spessasynth-info-logging[enables spessasynth's info log level]"
    )
    _arguments "${all_arguments[@]}"
    return 0
  }
}
__spessoplayer

